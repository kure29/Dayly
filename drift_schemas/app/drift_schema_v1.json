  "fixed_sql": [
    {
      "name": "task_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_templates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"target\" INTEGER NOT NULL, \"step\" INTEGER NOT NULL, \"unit\" TEXT NOT NULL, \"repeat_kind\" TEXT NOT NULL, \"repeat_days\" INTEGER NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, \"archived_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "daily_tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"template_id\" INTEGER NOT NULL REFERENCES task_templates (id), \"date\" TEXT NOT NULL, \"progress\" INTEGER NOT NULL DEFAULT 0, \"completed_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"target\" INTEGER NOT NULL, \"unit\" TEXT NOT NULL, \"step\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, UNIQUE (\"template_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "task_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"daily_task_id\" INTEGER NULL, \"template_id\" INTEGER NULL, \"date\" TEXT NOT NULL, \"delta\" INTEGER NOT NULL, \"new_progress\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"nickname\" TEXT NOT NULL, \"avatar_char\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"scheme_id\" TEXT NOT NULL, \"custom_accent\" INTEGER NULL, \"brightness_mode\" TEXT NOT NULL, \"day_start_hour\" INTEGER NOT NULL, \"reminder_enabled\" INTEGER NOT NULL CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_minutes\" INTEGER NOT NULL, \"seeded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"seeded\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_tasks_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX daily_tasks_date ON daily_tasks (date)"
        }
      ]
    },
    {
      "name": "task_events_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX task_events_date ON task_events (date)"
        }
      ]
    },
    {
      "name": "task_events_daily_task",
